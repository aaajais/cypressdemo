{
  "name": "cypressdemo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:run": "cypress run",
    "test:report": "cypress run --reporter mochawesome --reporter-options reportDir=mochawesome-report,overwrite=false,html=false,json=true",
    "merge:report": "mochawesome-merge mochawesome-report/*.json > mochawesome.json",
    "generate:report": "marge mochawesome.json --reportDir mochawesome-report-html",
    "report": "npm run test:report && npm run merge:report && npm run generate:report",
    "serve:report": "npx http-server mochawesome-report-html -p 8080 --silent"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "cypress": "^14.0.3",
    "mochawesome": "^7.0.1",
    "mochawesome-merge": "^4.2.0",
    "mochawesome-report-generator": "^5.2.0"
  }
}
